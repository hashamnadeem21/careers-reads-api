# Port the API listens on. The website runs on 3000 and the admin on 3001.
PORT=4000
# Proxies in front of the API in production (Railway/Render/Fly: 1).
TRUST_PROXY=1

# Postgres. Local: `npm run db:local` starts a private server on port 54329.
# Production: your Neon connection string. From Phase 8 on, only this API connects to it.
DATABASE_URL=postgres://postgres@localhost:54329/blognest

# Allowed browser origins, comma separated. Leave empty: the admin and website call the API
# from their servers, never from the browser.
CORS_ORIGINS=

# Signs access and refresh tokens. Generate with: openssl rand -hex 32
JWT_SECRET=
# Optional: access token lifetime (default 900 = 15 minutes) and refresh token lifetime (default 30 days).
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_DAYS=

# Server keys the admin and website send as X-Api-Key, so the API trusts their X-Client-IP header
# (per-visitor rate limits). Generate each with: openssl rand -hex 32
ADMIN_API_KEY=
SITE_API_KEY=

# The admin panel (invite links) and the website (cache refresh after saves).
ADMIN_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000
# Same value as REVALIDATE_SECRET on the website.
REVALIDATE_SECRET=

# Uploads. Production: a Vercel Blob token. Development: files go to UPLOADS_DIR (the website's
# public/uploads, so /uploads/… URLs work on the site).
BLOB_READ_WRITE_TOKEN=
UPLOADS_DIR=../blognest/public/uploads
# Self-hosted production uploads instead of Blob: the public URL Nginx serves UPLOADS_DIR at.
UPLOADS_PUBLIC_URL=
